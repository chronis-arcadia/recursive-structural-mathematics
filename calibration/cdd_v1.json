{
  "schema_version": "1.0",
  "name": "RSM calibration and sanity controls",
  "principle": "Stability labels are conditional on a declared audit profile and are independent from external truth labels.",
  "cases": [
    {
      "id": "identity_true_arithmetic",
      "domain": "logical",
      "input": "2 + 2 = 4",
      "transform_profile": "identity",
      "external_truth": "true",
      "expected_stability": "C1",
      "purpose": "Positive stable/correct control."
    },
    {
      "id": "identity_false_astronomy",
      "domain": "factual_text",
      "input": "The Sun orbits Earth once per day.",
      "transform_profile": "identity",
      "external_truth": "false",
      "expected_stability": "C1",
      "purpose": "Hard guard against interpreting C1 as truth."
    },
    {
      "id": "identity_liar_string",
      "domain": "natural_language",
      "input": "This sentence is false.",
      "transform_profile": "identity",
      "external_truth": "unknown",
      "expected_stability": "C1",
      "purpose": "A paradoxical string can be representationally stable."
    },
    {
      "id": "reverse_liar_two_cycle",
      "domain": "natural_language",
      "input": "This sentence is false.",
      "transform_profile": "reverse_string",
      "external_truth": "unknown",
      "expected_stability": "C3",
      "expected_cycle_period": 2,
      "purpose": "Shows transform-dependence and catches endpoint cherry-picking."
    },
    {
      "id": "reverse_palindrome",
      "domain": "text",
      "input": "never odd or even",
      "transform_profile": "normalized_palindrome_reverse",
      "external_truth": "not_applicable",
      "expected_stability": "C1",
      "purpose": "Same transform family can preserve some structures and disrupt others."
    },
    {
      "id": "progressive_text_erosion",
      "domain": "text",
      "input": "recursive structure should survive declared transforms",
      "transform_profile": "halve_suffix_each_step",
      "external_truth": "not_applicable",
      "expected_stability": "C3",
      "purpose": "Destructive-transform control."
    },
    {
      "id": "token_reordering",
      "domain": "text",
      "input": "alpha beta gamma",
      "transform_profile": "token_permutation",
      "external_truth": "not_applicable",
      "expected_stability": "metric_dependent",
      "purpose": "Sequence distance and token-set distance should disagree."
    },
    {
      "id": "code_refactor",
      "domain": "code",
      "input": "def add(a, b): return a + b",
      "transform_profile": "semantics_preserving_refactor",
      "external_truth": "validator_required",
      "expected_stability": "profile_dependent",
      "purpose": "Future benchmark case: task behavior should dominate surface similarity."
    },
    {
      "id": "code_bug_injection",
      "domain": "code",
      "input": "def add(a, b): return a + b",
      "transform_profile": "operator_mutation_plus_to_minus",
      "external_truth": "validator_required",
      "expected_stability": "profile_dependent",
      "purpose": "Semantic/task metrics should detect corruption that syntax metrics may underweight."
    }
  ]
}
